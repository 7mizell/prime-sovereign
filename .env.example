# Prime Sovereign Listings — Environment Variables
# Copy to .env and fill in your values

# Netlify
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Ollama (local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=kemet-comms

# Instagram Basic Display API (for DM outreach)
# Get from https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# SendGrid (for email outreach)
# Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxx
FROM_EMAIL=hello@primesovereign.com

# Outreach Config
LEADS_FILE=./leads/leads.csv
OUTREACH_LOG=./outreach/log.jsonl
DAILY_LIMIT=50

# Site URL (for Stripe success/cancel URLs)
URL=https://primesovereign.com